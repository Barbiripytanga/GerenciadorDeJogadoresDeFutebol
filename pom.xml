<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>br.senac.tads.dsw</groupId>
	<artifactId>demo</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>demo</name>
	<description>Projeto de demonstração com Spring Boot</description>

	<developers>
		<developer>
			<id>BarbiriPytanga</id>
			<name>Barbara de Oliveira Silva</name>
			<email>barbara.osilva16@senacsp.edu.br</email>
		</developer>
	</developers>
	<!-- Versão do TADS Spring Initializr: 1.1.8 -->
	<!-- hash-identificacao: 671baaba76f090b22806d0fc7f8f62484a2f03cec30a15bdc8bf8cf5a38322a5 -->

	<properties>
		<java.version>21</java.version>
	</properties>

	<dependencies>
		<dependency>
			<!-->starter-webmvc: é o Spring Web TRAZENDO o Spring MVC
			 e o Tomcat embutido, e é o que permite usar:
			 @RestController, @GetMapping e as demais anotações de rota.-->
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<!--starter-validation:Traz o Bean Validation, com anotações como @NotBlank, @Min e @Valid,
			eh usado para as regras de nome, time e camisa.-->
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Spring Data JPA (inclui Hibernate como implementação do JPA) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Banco de dados H2 em memória -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Console web do H2 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-h2console</artifactId>
		</dependency>

		<!--TESTES-->
		<dependency>
			<!--starter-test: traz as ferramentas de teste (JUnit, Mockito e outras).
             Veio sozinho, com scope de teste.-->
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Os dois proximos starters:trazem o suporte a teste de cada um dos dois starters acima.
		 Também são só de teste.-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
